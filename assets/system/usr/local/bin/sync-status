#!/usr/bin/env bash
#
# sync-status: Panel de control unificado y diagnóstico de todas las sincronizaciones
# Adaptado para espacio colaborativo multi-usuario /z-drive
#

set -eo pipefail

export RCLONE_CONFIG="${RCLONE_CONFIG:-/etc/rclone/rclone.conf}"

STATE_DIR="/z-drive/.sync-state"
LOCAL_BTRFS_MOUNT=$(findmnt -n -o TARGET /run/media/*/ALMACEN_BTRFS 2>/dev/null | head -n 1 || echo "/run/media/omarchy/ALMACEN_BTRFS")
LOCAL_BTRFS_DEST="${LOCAL_BTRFS_MOUNT}/gracie"
LOCAL_BTRFS_SNAPS="${LOCAL_BTRFS_MOUNT}/.snapshots"

# Configuración de Roles
IDALIA_ROLE="master"
if [[ -f "/etc/rclone/sync-idalia.conf" ]]; then
    # shellcheck disable=SC1090
    source "/etc/rclone/sync-idalia.conf"
elif [[ -f "${HOME}/.config/sync-idalia/config" ]]; then
    # shellcheck disable=SC1090
    source "${HOME}/.config/sync-idalia/config"
fi

UPLOADS_ROLE="master"
if [[ -f "/etc/rclone/sync-uploads-gracie.conf" ]]; then
    # shellcheck disable=SC1090
    source "/etc/rclone/sync-uploads-gracie.conf"
elif [[ -f "${HOME}/.config/sync-uploads-gracie/config" ]]; then
    # shellcheck disable=SC1090
    source "${HOME}/.config/sync-uploads-gracie/config"
fi

# Colores interactivos
if [[ -t 1 ]]; then
    BOLD="\033[1m"
    DIM="\033[2m"
    GREEN="\033[32m"
    YELLOW="\033[33m"
    CYAN="\033[36m"
    RESET="\033[0m"
else
    BOLD=""
    DIM=""
    GREEN=""
    YELLOW=""
    CYAN=""
    RESET=""
fi

# 1. Datos de Tries
TRIES_DIR="/z-drive/tries"
TRIES_FILES=0
TRIES_SIZE="0"
if [[ -d "$TRIES_DIR" ]]; then
    TRIES_FILES=$(find "$TRIES_DIR" -type f 2>/dev/null | wc -l)
    TRIES_SIZE=$(du -sh "$TRIES_DIR" 2>/dev/null | cut -f1)
fi

TRIES_STATE="🟢 Al día"
if pgrep -f "(bash .*/sync-tries( |$)|rclone (sync|copy) .*/tries)" >/dev/null 2>&1; then
    TRIES_STATE="🔄 Syncing"
elif [[ -f "${STATE_DIR}/sync-tries.log" ]]; then
    last_event=$(tail -n 15 "${STATE_DIR}/sync-tries.log" 2>/dev/null | grep -E "SEGURIDAD: ALERTA|finalizada exitosamente|finalizada con|completada exitosamente|ERROR" | tail -n 1 || true)
    if echo "$last_event" | grep -q "SEGURIDAD: ALERTA"; then
        TRIES_STATE="🛡️ Alerta"
    elif echo "$last_event" | grep -qiE "finalizada con [1-9]|ERROR"; then
        TRIES_STATE="🔴 Error"
    fi
fi

# 2. Datos de Idalia
IDALIA_DIR="/z-drive/idalia"
IDALIA_FILES=0
IDALIA_SIZE="0"
if [[ -d "$IDALIA_DIR" ]]; then
    IDALIA_FILES=$(find "$IDALIA_DIR" -type f 2>/dev/null | wc -l)
    IDALIA_SIZE=$(du -sh "$IDALIA_DIR" 2>/dev/null | cut -f1)
fi

IDALIA_STATE="🟢 Al día"
if pgrep -f "(bash .*/sync-idalia( |$)|rclone sync .*/idalia)" >/dev/null 2>&1; then
    IDALIA_STATE="🔄 Syncing"
elif [[ -f "${STATE_DIR}/sync-idalia.log" ]]; then
    last_event=$(tail -n 15 "${STATE_DIR}/sync-idalia.log" 2>/dev/null | grep -E "SEGURIDAD: ALERTA|completada exitosamente|ERROR" | tail -n 1 || true)
    if echo "$last_event" | grep -q "SEGURIDAD: ALERTA"; then
        IDALIA_STATE="🛡️ Alerta"
    elif echo "$last_event" | grep -qiE "ERROR"; then
        IDALIA_STATE="🔴 Error"
    fi
fi
IDALIA_TOPOLOGY="Google Drive [ROL: ${IDALIA_ROLE^^}]"

# 3. Datos de Uploads-Gracie
UPLOADS_DIR="/z-drive/uploads-gracie"
UPLOADS_FILES=0
UPLOADS_SIZE="0"
if [[ -d "$UPLOADS_DIR" ]]; then
    UPLOADS_FILES=$(find "$UPLOADS_DIR" -type f 2>/dev/null | wc -l)
    UPLOADS_SIZE=$(du -sh "$UPLOADS_DIR" 2>/dev/null | cut -f1)
fi

UPLOADS_STATE="🟢 Al día"
if pgrep -f "(bash .*/sync-uploads-gracie( |$)|rclone sync .*/uploads-gracie)" >/dev/null 2>&1; then
    UPLOADS_STATE="🔄 Syncing"
elif [[ -f "${STATE_DIR}/sync-uploads-gracie.log" ]]; then
    last_event=$(tail -n 15 "${STATE_DIR}/sync-uploads-gracie.log" 2>/dev/null | grep -E "SEGURIDAD: ALERTA|sincronizado exitosamente|descargado exitosamente|ERROR" | tail -n 1 || true)
    if echo "$last_event" | grep -q "SEGURIDAD: ALERTA"; then
        UPLOADS_STATE="🛡️ Alerta"
    elif echo "$last_event" | grep -qiE "ERROR"; then
        UPLOADS_STATE="🔴 Error"
    fi
fi
UPLOADS_TOPOLOGY="Google Drive [ROL: ${UPLOADS_ROLE^^}]"

echo -e "${BOLD}================================================================================================${RESET}"
echo -e "${BOLD}               CENTRO DE SINCRONIZACIÓN Y RESPALDOS /z-drive (ESTADO GLOBAL)                    ${RESET}"
echo -e "${BOLD}================================================================================================${RESET}"

echo -e "${BOLD}• Entorno del Sistema:${RESET}"
echo -e "  - Almacenamiento Colaborativo: ${GREEN}[✓ ACTIVO]${RESET} /z-drive (2770 root:wheel + ACLs)"
if [[ "$IDALIA_ROLE" == "master" ]]; then
    echo -e "  - Rol Multimedia (Idalia):    ${GREEN}${BOLD}MAESTRO${RESET} (/z-drive ➔ Google Drive)"
else
    echo -e "  - Rol Multimedia (Idalia):    ${CYAN}${BOLD}HIJA / RÉPLICA${RESET} (Google Drive ➔ /z-drive)"
fi

if command -v rclone >/dev/null 2>&1 && rclone listremotes 2>/dev/null | grep -q "gdrive:"; then
    echo -e "  - Google Drive:                ${GREEN}[✓ CONECTADO]${RESET} Remote 'gdrive:' activo"
else
    echo -e "  - Google Drive:                ${YELLOW}[!] NO DETECTADO${RESET} en rclone"
fi

if command -v rclone >/dev/null 2>&1 && rclone listremotes 2>/dev/null | grep -q "gdrive_boveda:"; then
    echo -e "  - Bóveda Privada (AES-256):    ${GREEN}[✓ ACTIVA]${RESET} Remote 'gdrive_boveda:' configurado"
else
    echo -e "  - Bóveda Privada (AES-256):    ${YELLOW}[!] NO CONFIGURADA${RESET} en rclone"
fi

if systemctl is-active --quiet rclone-gdrive-mount.service 2>/dev/null; then
    echo -e "  - Disco Virtual Cloud (FUSE):  ${GREEN}[✓ MONTADO]${RESET} en /z-drive/cloud (~/Cloud)"
else
    echo -e "  - Disco Virtual Cloud (FUSE):  ${DIM}[DESMONTADO]${RESET} (/z-drive/cloud inactivo)"
fi

if findmnt -M "$LOCAL_BTRFS_MOUNT" >/dev/null 2>&1; then
    AVAIL_LOCAL=$(/usr/bin/df -h "$LOCAL_BTRFS_MOUNT" | awk 'END {print $4}')
    echo -e "  - Disco Externo Btrfs:         ${GREEN}[✓ MONTADO]${RESET} en ${LOCAL_BTRFS_MOUNT} (${AVAIL_LOCAL} disponibles)"
else
    echo -e "  - Disco Externo Btrfs:         ${DIM}[DESCONECTADO]${RESET} (Sincronización a la nube continúa normalmente)"
fi

echo ""
echo -e "${BOLD}• Resumen Ejecutivo de Sincronizaciones:${RESET}"

python3 -c '
import sys, unicodedata

def dw(s):
    w = 0
    for c in s:
        if ord(c) == 0xFE0F:
            continue
        if unicodedata.east_asian_width(c) in ("W", "F") or ord(c) in (128994, 128260, 128737, 128308, 9898):
            w += 2
        else:
            w += 1
    return w

def pad(s, width):
    return s + " " * max(0, width - dw(s))

c1, c2, c3, c4 = "CARPETA", "ESTADO", "ARCHIVOS / TAMAÑO", "DESTINO / TOPOLOGÍA"
w1, w2, w3, w4 = 20, 14, 22, 32

print("  ┌" + "─" * (w1 + 2) + "┬" + "─" * (w2 + 2) + "┬" + "─" * (w3 + 2) + "┬" + "─" * (w4 + 2) + "┐")
print("  │ " + pad(c1, w1) + " │ " + pad(c2, w2) + " │ " + pad(c3, w3) + " │ " + pad(c4, w4) + " │")
print("  ├" + "─" * (w1 + 2) + "┼" + "─" * (w2 + 2) + "┼" + "─" * (w3 + 2) + "┼" + "─" * (w4 + 2) + "┤")

rows = [
    (sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]),
    (sys.argv[5], sys.argv[6], sys.argv[7], sys.argv[8]),
    (sys.argv[9], sys.argv[10], sys.argv[11], sys.argv[12])
]

for name, state, stats, topo in rows:
    print("  │ " + pad(name, w1) + " │ " + pad(state, w2) + " │ " + pad(stats, w3) + " │ " + pad(topo, w4) + " │")
print("  └" + "─" * (w1 + 2) + "┴" + "─" * (w2 + 2) + "┴" + "─" * (w3 + 2) + "┴" + "─" * (w4 + 2) + "┘")
' "Tries (Código)" "$TRIES_STATE" "$TRIES_FILES ($TRIES_SIZE)" "gdrive:gracie + Btrfs" \
  "Idalia (Multimedia)" "$IDALIA_STATE" "$IDALIA_FILES ($IDALIA_SIZE)" "$IDALIA_TOPOLOGY" \
  "Uploads-Gracie" "$UPLOADS_STATE" "$UPLOADS_FILES ($UPLOADS_SIZE)" "$UPLOADS_TOPOLOGY"

echo ""
echo -e "${BOLD}• Servicios Automáticos del Sistema (systemd):${RESET}"
SERVICES=("sync-tries.timer" "sync-idalia.timer" "sync-uploads-gracie.timer" "z-drive-perms.service" "rclone-gdrive-mount.service")
for s in "${SERVICES[@]}"; do
    if systemctl is-active --quiet "$s" 2>/dev/null; then
        echo -e "  - ${s}: ${GREEN}[✓ ACTIVO]${RESET}"
    elif systemctl is-enabled --quiet "$s" 2>/dev/null; then
        echo -e "  - ${s}: ${YELLOW}[HABILITADO]${RESET}"
    else
        echo -e "  - ${s}: ${DIM}[INACTIVO / NO INSTALADO]${RESET}"
    fi
done

echo ""
echo -e "${BOLD}• Últimos Registros (${STATE_DIR}):${RESET}"
for s in "sync-tries" "sync-idalia" "sync-uploads-gracie"; do
    log_file="${STATE_DIR}/${s}.log"
    if [[ -f "$log_file" ]]; then
        last_line=$(tail -n 1 "$log_file" 2>/dev/null || echo "Sin registros")
        echo -e "  - ${s}: ${DIM}${last_line}${RESET}"
    fi
done
echo -e "${BOLD}================================================================================================${RESET}"
