#!/usr/bin/env bash
#
# sync-all: Dispara la sincronización integral de todas las carpetas activas en /z-drive
#

set -eo pipefail

STATE_DIR="/z-drive/.sync-state"
mkdir -p "$STATE_DIR"
LOG_FILE="${STATE_DIR}/sync-all.log"

log() {
  local msg="[$(date '+%Y-%m-%d %H:%M:%S')] [SYNC-ALL] $*"
  echo "$msg"
  echo "$msg" >> "$LOG_FILE"
}

log "Iniciando ciclo global de sincronización en /z-drive..."

# 1. Tries (Código)
if command -v sync-tries >/dev/null 2>&1; then
  log ">> [1/3] Disparando sync-tries..."
  sync-tries || log "ADVERTENCIA: sync-tries finalizó con advertencias."
fi

# 2. Idalia (Multimedia)
if command -v sync-idalia >/dev/null 2>&1; then
  log ">> [2/3] Disparando sync-idalia..."
  sync-idalia || log "ADVERTENCIA: sync-idalia finalizó con advertencias."
fi

# 3. Uploads-Gracie
if command -v sync-uploads-gracie >/dev/null 2>&1; then
  log ">> [3/3] Disparando sync-uploads-gracie..."
  sync-uploads-gracie || log "ADVERTENCIA: sync-uploads-gracie finalizó con advertencias."
fi

log "Sincronización integral de todas las carpetas finalizada."
