[apply]
    whitespace = fix

[color]
    ui = true

[commit]
    verbose = true
    gpgsign = true

[core]
    editor = nvim
    pager = delta
    excludesFile = ~/.config/git/gitignore.global
    attributesFile = ~/.config/git/gitattributes.global
    ignorecase = false
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[credential]
    helper = cache --timeout 3600

[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential

[diff]
    colorMoved = default
    algorithm = histogram
    mnemonicPrefix = true

[fetch]
    prune = true
    output = compact

[help]
    autocorrect = 1

[init]
    defaultBranch = master

[interactive]
    diffFilter = delta --color-only --highlight-removed

[log]
    decorate = short

[merge]
    conflictstyle = diff3
    log = true
    stat = true

[protocol]
    version = 2

[pull]
    rebase = true
    ff = only

[push]
    autoSetupRemote = true
    default = current

[rebase]
    autoStash = true
    updateRefs = true
    autoSquash = true

[include]
    path = ~/.config/git/delta.gitconfig
    path = ~/.config/git/gitconfig_aliases

[delta]
    features = mantis-shrimp

[rerere]
    enabled = true
    autoupdate = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = -version:refname
    gpgsign = true

[safe]
    directory = *

[user]
    name = Roberto Flores
    email = 25asab015@ujmd.edu.sv
    signingkey = ~/.ssh/id_ed25519.pub

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
