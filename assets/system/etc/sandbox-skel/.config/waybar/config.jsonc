{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 8,
    "modules-left": [
        "hyprland/workspaces",
        "niri/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "memory",
        "tray",
        "custom/power"
    ],
    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },
    "niri/workspaces": {
        "format": "{index}"
    },
    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true
    },
    "clock": {
        "format": "🕒 {:%H:%M  •  %d %b %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "🔇 Mute",
        "format-icons": {
            "default": ["🔈", "🔉", "🔊"]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "tooltip": true
    },
    "memory": {
        "format": "💾 {percentage}%"
    },
    "tray": {
        "spacing": 10
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": "Menú de Energía (Reiniciar / Apagar / Salir)",
        "on-click": "/usr/local/bin/power-menu.sh"
    }
}
