#!/usr/bin/env bash
#
# forkhub: Suite Unificada y Declarativa de Gestión de Flota de Forks y Repositorios
# Gestiona el monitoreo local, auditoría contra upstream (GitHub API / Git) y
# sincronización idempotente (ADR 0024 / ADR 013) basada en /etc/forkhub/repos.d/*.conf
# (con fallback automático al directorio repos.d junto al script).
#

set -eo pipefail

SCRIPT_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
if [[ -n "${FORKHUB_CONF_DIR:-}" ]]; then
    CONF_DIR="$FORKHUB_CONF_DIR"
elif [[ -d "/etc/forkhub/repos.d" ]] && compgen -G "/etc/forkhub/repos.d/*.conf" >/dev/null; then
    CONF_DIR="/etc/forkhub/repos.d"
else
    CONF_DIR="${SCRIPT_DIR}/repos.d"
fi
LOG_FILE="/var/log/forkhub.log"

# Paleta de colores si hay TTY
if [[ -t 1 ]]; then
    BOLD="\033[1m"
    DIM="\033[2m"
    GREEN="\033[32m"
    YELLOW="\033[33m"
    CYAN="\033[36m"
    RED="\033[31m"
    MAGENTA="\033[35m"
    RESET="\033[0m"
else
    BOLD="" DIM="" GREEN="" YELLOW="" CYAN="" RED="" MAGENTA="" RESET=""
fi

log() {
    local target="${CURRENT_TARGET:-forkhub}"
    local msg
    msg="[$(date "+%Y-%m-%d %H:%M:%S")] [$target] $*"
    echo -e "$msg"
    if [[ -w "$LOG_FILE" ]] || [[ ! -e "$LOG_FILE" && -w "/var/log" ]]; then
        echo "$msg" >> "$LOG_FILE" 2>/dev/null || true
    fi
}

notify() {
    local title="$1"
    local msg="$2"
    local urgency="${3:-normal}"
    
    # Notificar al entorno de usuario actual si existe DISPLAY/WAYLAND_DISPLAY
    if command -v notify-send >/dev/null 2>&1 && [[ -n "${WAYLAND_DISPLAY:-${DISPLAY:-}}" ]]; then
        notify-send -u "$urgency" "$title" "$msg" 2>/dev/null || true
    fi

    # Si se ejecuta como servicio systemd/root, emitir a los escritorios Wayland activos
    if [[ -z "${WAYLAND_DISPLAY:-${DISPLAY:-}}" ]] && command -v notify-send >/dev/null 2>&1; then
        for u in /run/user/*; do
            local uid
            uid=$(basename "$u")
            if [[ "$uid" =~ ^[0-9]+$ ]] && [[ -e "$u/bus" ]]; then
                sudo -u "#$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=$u/bus" \
                    notify-send -u "$urgency" "$title" "$msg" 2>/dev/null || true
            fi
        done
    fi
}

ensure_safe_directory() {
    local dir="$1"
    if ! git config --system --get-all safe.directory 2>/dev/null | grep -Fxq "$dir"; then
        git config --system --add safe.directory "$dir" 2>/dev/null || true
    fi
}

show_help() {
    cat << EOF
${BOLD}Forkhub — Suite Declarativa de Gestión de Flota de Forks y Repositorios${RESET}

Uso:
  forkhub [COMANDO] [OBJETIVO] [OPCIONES]

Comandos principales:
  ${CYAN}status [--upstream]${RESET}          Muestra el dashboard de salud de clones locales (o contra upstream).
  ${CYAN}audit [--dirty-only]${RESET}         Audita toda la topología canónica (/z, /z-drive/tries, /opt/src, /zt) buscando repos sucios o sin push.
  ${CYAN}bare [audit|prune|sync]${RESET}      Supervisa repos bare (/z-home-repos/.bare), poda huérfanos y sincroniza.
  ${CYAN}upstream [-g <grupo>]${RESET}        Audita todos los forks en GitHub contra sus respectivos upstreams.
  ${CYAN}sync-upstream [fork|--all]${RESET}   Sincroniza forks contra upstream según su estrategia (ADR-0024 / ADR-013).
  ${CYAN}update [repo|--all]${RESET}          Actualiza idempotentemente los clones locales configurados.
  ${CYAN}add <nombre> <ruta>${RESET}          Registra un nuevo repositorio o fork en la flota.
  ${CYAN}remove <nombre>${RESET}              Retira un repositorio de la flota (no borra archivos).
  ${CYAN}list / repos${RESET}                 Lista los repositorios registrados, rutas y upstreams.

Opciones (para 'update', 'upstream' y 'sync-upstream'):
  -n, --dry-run                Modo simulación: consulta remotos sin alterar ramas ni árboles.
  -g, --group <grupo>          Filtra únicamente repositorios del grupo indicado (ej. 'clavis', 'omarchy', 'neovim').
  -a, --all                    Procesa todos los repositorios aplicables (por defecto).
  -f, --force                  Fuerza el fetch/check incluso si auto_update es false.
  -h, --help                   Muestra esta ayuda.

Ejemplos:
  forkhub upstream
  forkhub upstream --group clavis
  forkhub sync-upstream --all --dry-run
  forkhub sync-upstream nyxuri
  forkhub status
  forkhub update --group neovim
EOF
}

load_config() {
    local conf="$1"
    name=""
    # shellcheck disable=SC2034
    description=""
    repo_dir=""
    remote="origin"
    branch="main"
    group="general"
    auto_update=true
    post_update=""
    fork_repo=""
    upstream_repo=""
    upstream_branch=""
    sync_strategy="adr0024"

    # shellcheck disable=SC1090
    source "$conf"

    if [[ -z "$name" ]]; then
        return 1
    fi
    return 0
}

cmd_list() {
    echo -e "${BOLD}Repositorios registrados en Forkhub ($CONF_DIR):${RESET}"
    printf "  %-18s %-10s %-14s %-30s %s\n" "NOMBRE" "GRUPO" "RAMA" "UPSTREAM" "RUTA LOCAL"
    echo "  ----------------------------------------------------------------------------------------------------"
    shopt -s nullglob
    local confs=("$CONF_DIR"/*.conf)
    shopt -u nullglob

    if [[ ${#confs[@]} -eq 0 ]]; then
        echo -e "  ${YELLOW}No hay repositorios configurados.${RESET}"
        return 0
    fi

    for c in "${confs[@]}"; do
        if load_config "$c"; then
            local up_str="${upstream_repo:-N/A}"
            [[ -n "$upstream_branch" ]] && up_str="${up_str}:${upstream_branch}"
            printf "  %-18s %-10s %-14s %-30s %s\n" "$name" "$group" "$branch" "$up_str" "${repo_dir:-"(remoto)"}"
        fi
    done
}

cmd_upstream() {
    local target=""
    local group_filter=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -g|--group)
                group_filter="$2"
                shift 2
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                if [[ -z "$target" && "$1" != "--all" && "$1" != "-a" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    shopt -s nullglob
    local confs=("$CONF_DIR"/*.conf)
    shopt -u nullglob

    if [[ ${#confs[@]} -eq 0 ]]; then
        echo -e "${YELLOW}No hay repositorios configurados en $CONF_DIR.${RESET}"
        return 0
    fi

    if ! command -v gh >/dev/null 2>&1; then
        echo -e "${RED}Error: Se requiere 'gh' (GitHub CLI) para auditar forks contra upstream.${RESET}" >&2
        return 1
    fi

    echo -e "${BOLD}========================================================================================================${RESET}"
    echo -e "${BOLD}                 FORKHUB — Auditoría de Forks contra Upstream Oficial (GitHub API)                      ${RESET}"
    echo -e "${BOLD}========================================================================================================${RESET}"
    printf " %-18s %-9s %-14s %-30s %-22s %s\n" "FORK" "GRUPO" "RAMA FORK" "UPSTREAM (RAMA)" "ESTADO VS UPSTREAM" "ESTRATEGIA"
    echo -e "--------------------------------------------------------------------------------------------------------"

    local total=0
    local up_to_date=0
    local behind_count=0

    for c in "${confs[@]}"; do
        if ! load_config "$c"; then
            continue
        fi
        [[ -z "$fork_repo" || -z "$upstream_repo" ]] && continue
        [[ -n "$target" && "$target" != "$name" && "$target" != "${fork_repo#*/}" ]] && continue
        [[ -n "$group_filter" && "$group_filter" != "$group" ]] && continue

        total=$((total + 1))
        local up_owner="${upstream_repo%%/*}"
        local up_br="${upstream_branch:-main}"
        local cmp_json=""
        local status_badge=""

        if cmp_json=$(gh api "repos/${fork_repo}/compare/${up_owner}:${up_br}...${branch}" 2>/dev/null); then
            local behind ahead
            behind=$(python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("behind_by",0))' <<< "$cmp_json" 2>/dev/null || echo 0)
            ahead=$(python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("ahead_by",0))' <<< "$cmp_json" 2>/dev/null || echo 0)

            if [[ "$behind" -eq 0 ]]; then
                status_badge="${GREEN}🟢 Al día (+${ahead}/-0)${RESET}"
                up_to_date=$((up_to_date + 1))
            elif [[ "$sync_strategy" == "manual" || "$sync_strategy" == "frozen" || "$sync_strategy" == "none" ]]; then
                status_badge="${CYAN}❄️ Congelado (-${behind}/+${ahead})${RESET}"
                behind_count=$((behind_count + 1))
            else
                status_badge="${YELLOW}🔄 Detrás (-${behind}/+${ahead})${RESET}"
                behind_count=$((behind_count + 1))
            fi
        else
            status_badge="${RED}⚠️ Error API/Rama${RESET}"
        fi

        printf " %-18s %-9s %-14s %-30s %-31b %s\n" \
            "$name" "$group" "$branch" "${upstream_repo}:${up_br}" "$status_badge" "$sync_strategy"
    done

    echo -e "${BOLD}========================================================================================================${RESET}"
    echo -e " Resumen: ${BOLD}$total${RESET} forks auditados | ${GREEN}$up_to_date al día${RESET} | ${YELLOW}$behind_count con commits pendientes en upstream${RESET}"
}

cmd_sync_upstream() {
    local target=""
    local group_filter=""
    local dry_run=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run)
                dry_run=true
                shift
                ;;
            -g|--group)
                group_filter="$2"
                shift 2
                ;;
            -a|--all)
                target="--all"
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    shopt -s nullglob
    local confs=("$CONF_DIR"/*.conf)
    shopt -u nullglob

    local work_root
    work_root="$(mktemp -d "${TMPDIR:-/tmp}/forkhub-sync.XXXXXX")"
    trap 'rm -rf "$work_root" 2>/dev/null || true' EXIT

    local synced=0
    local skipped=0
    local failed=0

    for c in "${confs[@]}"; do
        if ! load_config "$c"; then
            continue
        fi
        [[ -z "$fork_repo" || -z "$upstream_repo" ]] && continue
        if [[ -n "$target" && "$target" != "--all" && "$target" != "$name" && "$target" != "${fork_repo#*/}" ]]; then
            continue
        fi
        if [[ -n "$group_filter" && "$group_filter" != "$group" ]]; then
            continue
        fi

        CURRENT_TARGET="$name"
        local up_owner="${upstream_repo%%/*}"
        local up_br="${upstream_branch:-main}"

        local cmp_json behind
        if ! cmp_json=$(gh api "repos/${fork_repo}/compare/${up_owner}:${up_br}...${branch}" 2>/dev/null); then
            log "ERROR: No se pudo comparar ${fork_repo} (${branch}) contra ${upstream_repo}:${up_br}."
            failed=$((failed + 1))
            continue
        fi

        behind=$(python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("behind_by",0))' <<< "$cmp_json" 2>/dev/null || echo 0)
        if [[ "$behind" -eq 0 ]]; then
            log "[✓] $name (${fork_repo}:${branch}) ya está al día contra ${upstream_repo}:${up_br}."
            skipped=$((skipped + 1))
            continue
        fi

        if [[ "$sync_strategy" == "manual" || "$sync_strategy" == "frozen" || "$sync_strategy" == "none" ]]; then
            log "[❄️ CONGELADO] $name tiene $behind commits pendientes en upstream pero su estrategia es $sync_strategy. Omitiendo sincronización automática."
            skipped=$((skipped + 1))
            continue
        fi

        if [[ "$dry_run" == "true" ]]; then
            log "[DRY-RUN] $name tiene $behind commits pendientes en ${upstream_repo}:${up_br} (estrategia: $sync_strategy)."
            continue
        fi

        log "Sincronizando $name (-$behind commits desde ${upstream_repo}:${up_br}, estrategia: $sync_strategy)..."
        local clone_dir="${work_root}/${name}"
        rm -rf "$clone_dir"

        if ! git clone "https://github.com/${fork_repo}.git" "$clone_dir" --quiet; then
            log "ERROR: Falló git clone de ${fork_repo}."
            failed=$((failed + 1))
            continue
        fi

        git -C "$clone_dir" remote add real-upstream "https://github.com/${upstream_repo}.git"
        git -C "$clone_dir" fetch --no-tags real-upstream "$up_br" --quiet
        git -C "$clone_dir" fetch origin --quiet

        case "$sync_strategy" in
            adr0024)
                if git -C "$clone_dir" show-ref --verify --quiet "refs/remotes/origin/upstream"; then
                    git -C "$clone_dir" checkout -B upstream origin/upstream --quiet
                    git -C "$clone_dir" merge --ff-only "real-upstream/${up_br}" --quiet
                else
                    git -C "$clone_dir" checkout -B upstream "real-upstream/${up_br}" --quiet
                fi
                git -C "$clone_dir" checkout -B "$branch" "origin/${branch}" --quiet
                if git -C "$clone_dir" rebase upstream --quiet; then
                    git -C "$clone_dir" push origin upstream --quiet
                    git -C "$clone_dir" push --force-with-lease origin "$branch" --quiet
                    log "¡ÉXITO! $name sincronizado (ADR 0024: upstream FF + rebase $branch)."
                    notify "🚀 Forkhub: $name sincronizado" "ADR 0024 aplicado con éxito contra ${upstream_repo}:${up_br}" "normal"
                    synced=$((synced + 1))

                    if [[ -d "$repo_dir" ]]; then
                        log "Actualizando clon local en $repo_dir..."
                        git -C "$repo_dir" fetch "$remote" "$branch" --quiet 2>/dev/null || true
                        if git -C "$repo_dir" merge --ff-only FETCH_HEAD --quiet 2>/dev/null; then
                            log "Clon local actualizado a $(git -C "$repo_dir" rev-parse --short HEAD)."
                            if [[ -n "$post_update" ]]; then
                                log "Ejecutando post_update hook: $post_update"
                                eval "$post_update" 2>&1 | while IFS= read -r line; do
                                    log "  [hook] $line"
                                done || true
                            fi
                        fi
                    fi
                else
                    git -C "$clone_dir" rebase --abort 2>/dev/null || true
                    log "ERROR: Conflicto al rebasear $name sobre ${upstream_repo}:${up_br}. Requiere resolución manual."
                    notify "⚠️ Forkhub: Conflicto en $name" "Conflicto al rebasear contra ${upstream_repo}:${up_br}. Requiere resolución manual." "critical"
                    failed=$((failed + 1))
                fi
                ;;
            rebase-branch)
                if git -C "$clone_dir" show-ref --verify --quiet "refs/remotes/origin/master"; then
                    git -C "$clone_dir" checkout -B master origin/master --quiet
                    git -C "$clone_dir" rebase "real-upstream/${up_br}" --quiet && \
                        git -C "$clone_dir" push --force-with-lease origin master --quiet
                fi
                git -C "$clone_dir" checkout -B "$branch" "origin/${branch}" --quiet
                if git -C "$clone_dir" rebase "real-upstream/${up_br}" --quiet; then
                    git -C "$clone_dir" push --force-with-lease origin "$branch" --quiet
                    log "¡ÉXITO! $name sincronizado (rebase de $branch sobre ${upstream_repo}:${up_br})."
                    notify "🚀 Forkhub: $name sincronizado" "Rebase aplicado con éxito sobre ${upstream_repo}:${up_br}" "normal"
                    synced=$((synced + 1))

                    if [[ -d "$repo_dir" ]]; then
                        log "Actualizando clon local en $repo_dir..."
                        git -C "$repo_dir" fetch "$remote" "$branch" --quiet 2>/dev/null || true
                        if git -C "$repo_dir" merge --ff-only FETCH_HEAD --quiet 2>/dev/null; then
                            log "Clon local actualizado a $(git -C "$repo_dir" rev-parse --short HEAD)."
                            if [[ -n "$post_update" ]]; then
                                log "Ejecutando post_update hook: $post_update"
                                eval "$post_update" 2>&1 | while IFS= read -r line; do
                                    log "  [hook] $line"
                                done || true
                            fi
                        fi
                    fi
                else
                    git -C "$clone_dir" rebase --abort 2>/dev/null || true
                    log "ERROR: Conflicto al rebasear $name ($branch)."
                    notify "⚠️ Forkhub: Conflicto en $name" "Conflicto al rebasear $name ($branch). Requiere resolución manual." "critical"
                    failed=$((failed + 1))
                fi
                ;;
            ff-only)
                git -C "$clone_dir" checkout -B "$branch" "origin/${branch}" --quiet
                if git -C "$clone_dir" merge --ff-only "real-upstream/${up_br}" --quiet; then
                    git -C "$clone_dir" push origin "$branch" --quiet
                    log "¡ÉXITO! $name actualizado por fast-forward."
                    notify "🚀 Forkhub: $name sincronizado" "Fast-forward aplicado con éxito desde ${upstream_repo}:${up_br}" "normal"
                    synced=$((synced + 1))

                    if [[ -d "$repo_dir" ]]; then
                        log "Actualizando clon local en $repo_dir..."
                        git -C "$repo_dir" fetch "$remote" "$branch" --quiet 2>/dev/null || true
                        if git -C "$repo_dir" merge --ff-only FETCH_HEAD --quiet 2>/dev/null; then
                            log "Clon local actualizado a $(git -C "$repo_dir" rev-parse --short HEAD)."
                            if [[ -n "$post_update" ]]; then
                                log "Ejecutando post_update hook: $post_update"
                                eval "$post_update" 2>&1 | while IFS= read -r line; do
                                    log "  [hook] $line"
                                done || true
                            fi
                        fi
                    fi
                else
                    log "ERROR: No se pudo hacer fast-forward en $name."
                    notify "⚠️ Forkhub: Error FF en $name" "No se pudo realizar fast-forward desde ${upstream_repo}:${up_br}." "critical"
                    failed=$((failed + 1))
                fi
                ;;
            adr013)
                local up_sha br_sync pr_url
                up_sha=$(git -C "$clone_dir" rev-parse --short "real-upstream/${up_br}")
                br_sync="sync/${up_br}-$(date -u +%Y%m%d)-${up_sha}"
                git -C "$clone_dir" checkout -B "$branch" "origin/${branch}" --quiet
                git -C "$clone_dir" checkout -b "$br_sync" --quiet
                if git -C "$clone_dir" merge --no-ff --no-edit -m "Merge ${upstream_repo}/${up_br} ($up_sha) en ${branch}" "real-upstream/${up_br}"; then
                    git -C "$clone_dir" push origin "real-upstream/${up_br}:refs/heads/upstream" --quiet || true
                    git -C "$clone_dir" push origin "$br_sync" --quiet
                    pr_url=$(gh pr create -R "$fork_repo" --base "$branch" --head "$br_sync" \
                        --title "sync: merge ${upstream_repo}/${up_br} ${up_sha}" \
                        --body "Merge automático vía forkhub (ADR-013). Sin rebase ni force-push.")
                    gh pr merge "$pr_url" --merge --delete-branch --match-head-commit "$(git -C "$clone_dir" rev-parse HEAD)"
                    log "¡ÉXITO! $name sincronizado vía PR merge-commit ($pr_url)."
                    notify "🚀 Forkhub: $name sincronizado" "PR creado y mergeado: $pr_url" "normal"
                    synced=$((synced + 1))

                    if [[ -d "$repo_dir" ]]; then
                        log "Actualizando clon local en $repo_dir..."
                        git -C "$repo_dir" fetch "$remote" "$branch" --quiet 2>/dev/null || true
                        if git -C "$repo_dir" merge --ff-only FETCH_HEAD --quiet 2>/dev/null; then
                            log "Clon local actualizado a $(git -C "$repo_dir" rev-parse --short HEAD)."
                            if [[ -n "$post_update" ]]; then
                                log "Ejecutando post_update hook: $post_update"
                                eval "$post_update" 2>&1 | while IFS= read -r line; do
                                    log "  [hook] $line"
                                done || true
                            fi
                        fi
                    fi
                else
                    git -C "$clone_dir" merge --abort 2>/dev/null || true
                    log "ERROR: Conflicto de merge en $name (ADR-013). Requiere resolución en rama $br_sync."
                    notify "⚠️ Forkhub: Conflicto en $name" "Conflicto de merge contra ${upstream_repo}:${up_br} (ADR-013). Requiere resolución en rama $br_sync." "critical"
                    failed=$((failed + 1))
                fi
                ;;
        esac
    done

    CURRENT_TARGET="forkhub"
    log "Sincronización upstream finalizada. Sincronizados: $synced | Al día: $skipped | Con errores/conflictos: $failed"
}

cmd_status() {
    if [[ "${1:-}" == "--upstream" || "${1:-}" == "-u" ]]; then
        shift
        cmd_upstream "$@"
        return 0
    fi

    shopt -s nullglob
    local confs=("$CONF_DIR"/*.conf)
    shopt -u nullglob

    if [[ ${#confs[@]} -eq 0 ]]; then
        echo -e "${YELLOW}No hay repositorios configurados en $CONF_DIR.${RESET}"
        return 0
    fi

    echo -e "${BOLD}================================================================================${RESET}"
    echo -e "${BOLD}           FORKHUB — Dashboard de Salud de Flota de Repositorios                ${RESET}"
    echo -e "${BOLD}================================================================================${RESET}"
    printf " %-18s %-9s %-15s %-25s %s\n" "REPOSITORIO" "GRUPO" "RAMA" "ESTADO LOCAL" "ÚLTIMO COMMIT"
    echo -e "--------------------------------------------------------------------------------"

    for c in "${confs[@]}"; do
        if ! load_config "$c"; then
            continue
        fi
        [[ -z "$repo_dir" ]] && continue

        CURRENT_TARGET="$name"
        local status_badge=""
        local last_commit=""

        if [[ ! -d "$repo_dir" ]]; then
            status_badge="${DIM}⚪ No clonado local${RESET}"
            last_commit="${fork_repo:-N/A}"
            printf " %-18s %-9s %-15s %-34b %s\n" "$name" "$group" "$branch" "$status_badge" "$last_commit"
            continue
        fi

        ensure_safe_directory "$repo_dir"

        if ! git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            status_badge="${RED}❌ No es repo Git${RESET}"
            last_commit="N/A"
            printf " %-18s %-9s %-15s %-34b %s\n" "$name" "$group" "$branch" "$status_badge" "$last_commit"
            continue
        fi

        # Comprobar si hay cambios sucios en el árbol local
        local dirty=""
        if ! git -C "$repo_dir" diff --quiet 2>/dev/null || ! git -C "$repo_dir" diff --cached --quiet 2>/dev/null; then
            dirty=" ${YELLOW}(modificado)${RESET}"
        fi

        # Obtener último commit local
        local head_hash
        head_hash=$(git -C "$repo_dir" rev-parse --short HEAD 2>/dev/null || echo "unknown")
        last_commit=$(git -C "$repo_dir" log -1 --format="%cd (%s)" --date=relative 2>/dev/null | cut -c1-38 || echo "N/A")

        # Consultar remoto
        local fetch_err=0
        git -C "$repo_dir" fetch "$remote" "$branch" --quiet 2>/dev/null || fetch_err=1

        if [[ $fetch_err -ne 0 ]]; then
            status_badge="${YELLOW}⚠️ Sin conexión/Remoto${RESET}"
        else
            local local_rev remote_rev behind ahead
            local_rev=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || echo "")
            remote_rev=$(git -C "$repo_dir" rev-parse "FETCH_HEAD" 2>/dev/null || echo "")

            if [[ "$local_rev" == "$remote_rev" ]]; then
                status_badge="${GREEN}🟢 Al día ($head_hash)${RESET}$dirty"
            else
                behind=$(git -C "$repo_dir" rev-list --count HEAD..FETCH_HEAD 2>/dev/null || echo 0)
                ahead=$(git -C "$repo_dir" rev-list --count FETCH_HEAD..HEAD 2>/dev/null || echo 0)

                if [[ $behind -gt 0 && $ahead -eq 0 ]]; then
                    status_badge="${CYAN}🔄 Pendiente (+$behind)${RESET}$dirty"
                elif [[ $behind -eq 0 && $ahead -gt 0 ]]; then
                    status_badge="${MAGENTA}⬆️ Adelantado ($ahead commits)${RESET}$dirty"
                else
                    status_badge="${RED}⚠️ Divergente (+${behind}/-${ahead})${RESET}$dirty"
                fi
            fi
        fi

        printf " %-18s %-9s %-15s %-34b %s\n" "$name" "$group" "$branch" "$status_badge" "$last_commit"
    done
    echo -e "${BOLD}================================================================================${RESET}"
}

cmd_audit() {
    local dirty_only=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--dirty-only) dirty_only=true; shift ;;
            -h|--help)
                echo "Uso: forkhub audit [-d|--dirty-only]"
                echo "Audita toda la topología canónica de repositorios buscando cambios sin commit, commits sin push o clones en /zt."
                return 0
                ;;
            *)
                echo -e "${RED}Opción desconocida en audit: $1${RESET}" >&2
                return 1
                ;;
        esac
    done

    local roots=(
        "/z-home-repos"
        "/z-home-repos/repos"
        "/z/vaults"
        "/z/pj-omarchy"
        "/z/rf-dotfiles"
        "/z/nvims"
        "/z/wallpaper-collection"
        "/z-drive/tries"
        "/opt/src"
        "/zt"
    )

    local raw_repos=()
    local r
    for r in "${roots[@]}"; do
        [[ -d "$r" ]] || continue
        local depth=3
        [[ "$r" == "/z-home-repos/repos" ]] && depth=5
        while IFS= read -r git_marker; do
            raw_repos+=("$(dirname "$git_marker")")
        done < <(find "$r" -maxdepth "$depth" -name ".git" 2>/dev/null | sort)
    done

    local repos=()
    while IFS= read -r repo_path; do
        [[ -n "$repo_path" ]] && repos+=("$repo_path")
    done < <(printf '%s\n' "${raw_repos[@]}" | sort -u)

    echo -e "${BOLD}========================================================================================================${RESET}"
    echo -e "${BOLD}          FORKHUB AUDIT — Salud Global de Flota y Topología Canónica (Dirty / Unpushed)              ${RESET}"
    echo -e "${BOLD}========================================================================================================${RESET}"
    printf " %-46s %-16s %-22s %s\n" "REPOSITORIO" "RAMA" "SINCRONIZACIÓN" "ÁRBOL"
    echo -e "--------------------------------------------------------------------------------------------------------"

    local total=0 dirty_cnt=0 unpushed_cnt=0 noncanon_cnt=0
    local repo branch porcelain sync_badge tree_badge issue_flag

    for repo in "${repos[@]}"; do
        total=$((total + 1))
        ensure_safe_directory "$repo"

        branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "detached")
        porcelain=$(git -C "$repo" status --porcelain 2>/dev/null || true)

        issue_flag=false
        if [[ -n "$porcelain" ]]; then
            local changed_count
            changed_count=$(printf "%s\n" "$porcelain" | wc -l | tr -d ' ')
            tree_badge="${YELLOW}✏️ Sucio (${changed_count})${RESET}"
            dirty_cnt=$((dirty_cnt + 1))
            issue_flag=true
        else
            tree_badge="${GREEN}✓ Limpio${RESET}"
        fi

        local upstream ahead
        upstream=$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)
        if [[ -z "$upstream" ]]; then
            sync_badge="${YELLOW}⚠️ Sin upstream${RESET}"
            unpushed_cnt=$((unpushed_cnt + 1))
            issue_flag=true
        else
            ahead=$(git -C "$repo" rev-list --count "${upstream}..HEAD" 2>/dev/null || echo 0)
            if [[ "$ahead" -gt 0 ]]; then
                sync_badge="${MAGENTA}⬆️ Sin push (+${ahead})${RESET}"
                unpushed_cnt=$((unpushed_cnt + 1))
                issue_flag=true
            else
                sync_badge="${GREEN}🟢 Al día${RESET}"
            fi
        fi

        if [[ "$repo" == /zt/* ]]; then
            sync_badge="${RED}⚠️ /zt (Fuera topología)${RESET}"
            noncanon_cnt=$((noncanon_cnt + 1))
            issue_flag=true
        fi

        if [[ "$dirty_only" == "true" && "$issue_flag" == "false" ]]; then
            continue
        fi

        local short_repo="$repo"
        if [[ ${#short_repo} -gt 45 ]]; then
            short_repo="...${short_repo: -42}"
        fi
        local short_branch="$branch"
        if [[ ${#short_branch} -gt 15 ]]; then
            short_branch="${short_branch:0:12}..."
        fi

        printf " %-46s %-16s %-31b %b\n" "$short_repo" "$short_branch" "$sync_badge" "$tree_badge"
    done

    echo -e "${BOLD}========================================================================================================${RESET}"
    echo -e " Resumen: ${BOLD}$total${RESET} repos | ${YELLOW}$dirty_cnt sucios${RESET} | ${MAGENTA}$unpushed_cnt sin push/upstream${RESET} | ${RED}$noncanon_cnt en /zt${RESET}"

    echo ""
    local bare_opts=()
    [[ "$dirty_only" == "true" ]] && bare_opts+=("--dirty-only")
    audit_bare_repos --inline "${bare_opts[@]}"
}

get_bare_root() {
    if [[ -n "${RAVN_HOME_REPOS_ROOT:-}" && -d "${RAVN_HOME_REPOS_ROOT%/}/.bare" ]]; then
        printf '%s\n' "${RAVN_HOME_REPOS_ROOT%/}/.bare"
    elif [[ -d "/z-home-repos/.bare" ]]; then
        printf '%s\n' "/z-home-repos/.bare"
    elif [[ -d "${HOME}/z-home-repos/.bare" ]]; then
        printf '%s\n' "${HOME}/z-home-repos/.bare"
    else
        printf '%s\n' "/z-home-repos/.bare"
    fi
}

get_worktree_base() {
    local bare_name="$1"
    local repo_base="${bare_name%.git}"
    local root_base
    if [[ -n "${RAVN_HOME_REPOS_ROOT:-}" && -d "${RAVN_HOME_REPOS_ROOT%/}/repos" ]]; then
        root_base="${RAVN_HOME_REPOS_ROOT%/}/repos"
    elif [[ -d "/z-home-repos/repos" ]]; then
        root_base="/z-home-repos/repos"
    elif [[ -d "${HOME}/z-home-repos/repos" ]]; then
        root_base="${HOME}/z-home-repos/repos"
    else
        root_base="/z-home-repos/repos"
    fi
    printf '%s/%s\n' "$root_base" "$repo_base"
}

audit_bare_repos() {
    local inline=false
    local dirty_only=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --inline) inline=true; shift ;;
            -d|--dirty-only) dirty_only=true; shift ;;
            -h|--help)
                echo "Uso: forkhub bare audit [-d|--dirty-only]"
                echo "Supervisa el estado de repositorios bare centralizados, detectando worktrees huérfanos, locks activos y refspecs no canónicos."
                return 0
                ;;
            *)
                shift
                ;;
        esac
    done

    local bare_root
    bare_root=$(get_bare_root)

    if [[ ! -d "$bare_root" ]]; then
        echo -e "${YELLOW}Aviso: No se encontró el directorio de repositorios bare en $bare_root${RESET}"
        return 0
    fi

    local bare_list=()
    while IFS= read -r b; do
        [[ -n "$b" ]] && bare_list+=("$b")
    done < <(find "$bare_root" -maxdepth 1 \( -name "*.git" -o -name ".*.git" \) -type d 2>/dev/null | sort)

    if [[ ${#bare_list[@]} -eq 0 ]]; then
        echo -e "${YELLOW}Aviso: No hay repositorios bare (.git) en $bare_root${RESET}"
        return 0
    fi

    echo -e "${BOLD}========================================================================================================${RESET}"
    echo -e "${BOLD}          FORKHUB BARE — Repositorios Bare Centralizados (${bare_root})                ${RESET}"
    echo -e "${BOLD}========================================================================================================${RESET}"
    printf " %-35s %-16s %-18s %s\n" "BARE REPOSITORIO" "REFSPEC" "LOCKS" "WORKTREES REGISTRADOS"
    echo -e "--------------------------------------------------------------------------------------------------------"

    local total=0 locks_total=0 orphans_total=0 canon_total=0 printed_rows=0

    for bare in "${bare_list[@]}"; do
        total=$((total + 1))
        local name
        name=$(basename "$bare")
        ensure_safe_directory "$bare"

        local issue_flag=false

        # 1. Refspec
        local refspec
        refspec=$(git --git-dir="$bare" config --get remote.origin.fetch 2>/dev/null || true)
        local refspec_badge
        if [[ -z "$refspec" ]]; then
            refspec_badge="${YELLOW}⚠️ Sin fetch${RESET}"
            issue_flag=true
        elif [[ "$refspec" == "+refs/heads/*:refs/remotes/origin/*" ]]; then
            refspec_badge="${GREEN}✓ Canon${RESET}"
            canon_total=$((canon_total + 1))
        else
            refspec_badge="${YELLOW}⚠️ No-canon${RESET}"
            issue_flag=true
        fi

        # 2. Locks activos
        local locks
        locks=$(find "$bare" -maxdepth 3 -name "*.lock" 2>/dev/null || true)
        local lock_badge
        local lock_count=0
        if [[ -n "$locks" ]]; then
            lock_count=$(printf "%s\n" "$locks" | wc -l | tr -d ' ')
            lock_badge="${RED}🔒 ${lock_count} lock(s)${RESET}"
            locks_total=$((locks_total + lock_count))
            issue_flag=true
        else
            lock_badge="${GREEN}✓ Limpio${RESET}"
        fi

        # 3. Worktrees registrados y huérfanos
        local wt_count=0
        local orphan_count=0
        while IFS= read -r line; do
            if [[ "$line" =~ ^worktree\ (.*)$ ]]; then
                local wt="${BASH_REMATCH[1]}"
                if [[ "$wt" == "$bare" ]]; then
                    continue
                fi
                wt_count=$((wt_count + 1))
                if [[ ! -d "$wt" ]]; then
                    orphan_count=$((orphan_count + 1))
                fi
            fi
        done < <(git --git-dir="$bare" worktree list --porcelain 2>/dev/null || true)

        local wt_badge
        local wt_dir
        wt_dir=$(get_worktree_base "$name")
        if [[ $orphan_count -gt 0 ]]; then
            wt_badge="${RED}⚠️ ${wt_count} wt (${orphan_count} huérfano(s))${RESET}"
            orphans_total=$((orphans_total + orphan_count))
            issue_flag=true
        elif [[ $wt_count -gt 0 ]]; then
            wt_badge="${CYAN}${wt_count} wt${RESET} ${DIM}(${wt_dir})${RESET}"
        else
            wt_badge="${DIM}0 wt${RESET}"
        fi

        if [[ "$dirty_only" == "true" && "$issue_flag" == "false" ]]; then
            continue
        fi

        printed_rows=$((printed_rows + 1))
        local short_name="$name"
        if [[ ${#short_name} -gt 34 ]]; then
            short_name="${short_name:0:31}..."
        fi

        printf " %-35s %-25b %-27b %b\n" "$short_name" "$refspec_badge" "$lock_badge" "$wt_badge"
    done

    if [[ "$dirty_only" == "true" && $printed_rows -eq 0 ]]; then
        echo -e " ${GREEN}✓ Todos los repositorios bare están saludables (sin huérfanos, sin locks, refspec canónico).${RESET}"
    fi

    echo -e "${BOLD}========================================================================================================${RESET}"
    echo -e " Resumen Bare: ${BOLD}$total${RESET} repos | ${RED}$locks_total con locks${RESET} | ${YELLOW}$orphans_total huérfanos${RESET} | ${GREEN}$canon_total refspec canónicos${RESET}"
}

prune_bare_repos() {
    local bare_root
    bare_root=$(get_bare_root)

    if [[ ! -d "$bare_root" ]]; then
        echo -e "${RED}Error: Directorio bare no encontrado en $bare_root${RESET}"
        return 1
    fi

    echo -e "${BOLD}Iniciando limpieza y poda de worktrees huérfanos en: $bare_root${RESET}"
    local total=0 pruned=0
    local bare_list=()
    while IFS= read -r b; do
        [[ -n "$b" ]] && bare_list+=("$b")
    done < <(find "$bare_root" -maxdepth 1 \( -name "*.git" -o -name ".*.git" \) -type d 2>/dev/null | sort)

    for bare in "${bare_list[@]}"; do
        total=$((total + 1))
        local name
        name=$(basename "$bare")
        ensure_safe_directory "$bare"

        local has_orphan=false
        while IFS= read -r line; do
            if [[ "$line" =~ ^worktree\ (.*)$ ]]; then
                local wt="${BASH_REMATCH[1]}"
                if [[ "$wt" != "$bare" && ! -d "$wt" ]]; then
                    has_orphan=true
                    break
                fi
            fi
        done < <(git --git-dir="$bare" worktree list --porcelain 2>/dev/null || true)

        if [[ "$has_orphan" == "true" ]]; then
            echo -e "  ${YELLOW}Podando worktrees huérfanos en $name...${RESET}"
            git --git-dir="$bare" worktree prune -v 2>&1 | while IFS= read -r out; do
                echo "    $out"
            done
            pruned=$((pruned + 1))
        fi
    done

    if [[ $pruned -eq 0 ]]; then
        echo -e "${GREEN}✓ No se detectaron worktrees huérfanos. Todos los $total repos bare están limpios.${RESET}"
    else
        echo -e "${GREEN}✓ Poda finalizada. $pruned repos podados de un total de $total repos bare.${RESET}"
    fi
}

sync_bare_repos() {
    local dry_run=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run)
                dry_run=true
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    local bare_root
    bare_root=$(get_bare_root)

    if [[ ! -d "$bare_root" ]]; then
        echo -e "${RED}Error: Directorio bare no encontrado en $bare_root${RESET}"
        return 1
    fi

    echo -e "${BOLD}Sincronizando remotos (fetch --prune) en: $bare_root${RESET}"
    local total=0 synced=0 failed=0
    local bare_list=()
    while IFS= read -r b; do
        [[ -n "$b" ]] && bare_list+=("$b")
    done < <(find "$bare_root" -maxdepth 1 \( -name "*.git" -o -name ".*.git" \) -type d 2>/dev/null | sort)

    for bare in "${bare_list[@]}"; do
        total=$((total + 1))
        local name
        name=$(basename "$bare")
        ensure_safe_directory "$bare"

        if [[ "$dry_run" == "true" ]]; then
            echo -e "  [simulación] $name: git fetch --dry-run --prune origin"
            if git --git-dir="$bare" fetch --dry-run --prune origin >/dev/null 2>&1; then
                synced=$((synced + 1))
            else
                failed=$((failed + 1))
            fi
        else
            echo -e "  ${CYAN}Fetch $name...${RESET}"
            if git --git-dir="$bare" fetch --prune origin 2>/dev/null; then
                synced=$((synced + 1))
            else
                echo -e "    ${RED}⚠️ Falló fetch en $name (sin remoto origin o sin conexión)${RESET}"
                failed=$((failed + 1))
            fi
        fi
    done

    echo -e "${GREEN}✓ Sincronización finalizada. $synced sincronizados exitosamente, $failed con errores (Total: $total).${RESET}"
}

cmd_bare() {
    local action="${1:-audit}"
    case "$action" in
        audit|status)
            shift || true
            audit_bare_repos "$@"
            ;;
        prune)
            shift || true
            prune_bare_repos "$@"
            ;;
        sync|fetch)
            shift || true
            sync_bare_repos "$@"
            ;;
        -h|--help|help)
            echo -e "${BOLD}Forkhub Bare — Gestión y Supervisión de Repositorios Bare Centralizados${RESET}"
            echo ""
            echo "Uso:"
            echo "  forkhub bare [audit|prune|sync] [OPCIONES]"
            echo ""
            echo "Comandos:"
            echo -e "  ${CYAN}audit [-d|--dirty-only]${RESET} Audita repositorios bare, worktrees huérfanos, locks y refspecs."
            echo -e "  ${CYAN}prune${RESET}                  Ejecuta 'git worktree prune' en todos los repositorios bare."
            echo -e "  ${CYAN}sync [-n|--dry-run]${RESET}    Sincroniza todos los repos bare con 'git fetch --prune origin'."
            echo ""
            ;;
        *)
            echo -e "${RED}Comando bare no reconocido: $action${RESET}"
            echo "Uso: forkhub bare [audit|prune|sync]"
            return 1
            ;;
    esac
}

cmd_update() {
    local target=""
    local group_filter=""
    local dry_run=false
    local force=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -n|--dry-run)
                dry_run=true
                shift
                ;;
            -g|--group)
                group_filter="$2"
                shift 2
                ;;
            -a|--all)
                target="--all"
                shift
                ;;
            -f|--force)
                force=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            *)
                if [[ -z "$target" ]]; then
                    target="$1"
                fi
                shift
                ;;
        esac
    done

    shopt -s nullglob
    local confs=("$CONF_DIR"/*.conf)
    shopt -u nullglob

    if [[ ${#confs[@]} -eq 0 ]]; then
        log "No hay repositorios configurados en $CONF_DIR."
        return 0
    fi

    log "Iniciando ciclo de actualización de flota forkhub..."
    local updated_count=0
    local up_to_date_count=0
    local error_count=0

    for c in "${confs[@]}"; do
        if ! load_config "$c"; then
            continue
        fi
        [[ -z "$repo_dir" ]] && continue

        # Filtrar por nombre si se especificó uno
        if [[ -n "$target" && "$target" != "--all" && "$target" != "$name" ]]; then
            continue
        fi

        # Filtrar por grupo si se especificó
        if [[ -n "$group_filter" && "$group_filter" != "$group" ]]; then
            continue
        fi

        # Si es --all y auto_update es falso, omitir a menos que se fuerce
        if [[ "$target" == "--all" && "$auto_update" == "false" && "$force" == "false" ]]; then
            continue
        fi

        CURRENT_TARGET="$name"

        if [[ ! -d "$repo_dir" ]]; then
            continue
        fi

        ensure_safe_directory "$repo_dir"

        if ! git -C "$repo_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            log "ERROR: $repo_dir no es un repositorio Git válido."
            error_count=$((error_count + 1))
            continue
        fi

        # Fetch silencioso
        if ! git -C "$repo_dir" fetch "$remote" "$branch" --quiet 2>/dev/null; then
            log "ADVERTENCIA: No se pudo obtener el remoto '$remote/$branch'. Compruebe conectividad."
            error_count=$((error_count + 1))
            continue
        fi

        local local_rev remote_rev behind
        local_rev=$(git -C "$repo_dir" rev-parse HEAD 2>/dev/null || echo "")
        remote_rev=$(git -C "$repo_dir" rev-parse "FETCH_HEAD" 2>/dev/null || echo "")

        if [[ "$local_rev" == "$remote_rev" ]]; then
            log "[✓] $name: Al día (${local_rev:0:7}). Sin cambios pendientes en $remote/$branch."
            up_to_date_count=$((up_to_date_count + 1))
            continue
        fi

        behind=$(git -C "$repo_dir" rev-list --count HEAD..FETCH_HEAD 2>/dev/null || echo 0)

        if [[ $behind -eq 0 ]]; then
            log "[✓] $name: El árbol local está adelantado o no hay commits para integrar."
            up_to_date_count=$((up_to_date_count + 1))
            continue
        fi

        if [[ "$dry_run" == "true" ]]; then
            log "[SIMULACIÓN] $name: Hay $behind commits nuevos disponibles en $remote/$branch (${remote_rev:0:7})."
            continue
        fi

        log "Actualizando $name ($behind nuevos commits desde $remote/$branch)..."

        # Intentar fast-forward limpio
        if git -C "$repo_dir" merge --ff-only FETCH_HEAD --quiet; then
            local new_hash
            new_hash=$(git -C "$repo_dir" rev-parse --short HEAD)
            log "¡ÉXITO! $name actualizado a $new_hash."
            updated_count=$((updated_count + 1))

            # Ejecutar hook post_update si existe
            if [[ -n "$post_update" ]]; then
                log "Ejecutando post_update hook: $post_update"
                eval "$post_update" 2>&1 | while IFS= read -r line; do
                    log "  [hook] $line"
                done || true
            fi

            notify "🚀 Forkhub: $name actualizado" "$behind nuevos commits aplicados con éxito ($new_hash)"
        else
            log "ERROR: Falló el fast-forward en $name. La rama tiene modificaciones locales o divergencia."
            error_count=$((error_count + 1))
            notify "⚠️ Forkhub: Error en $name" "No se pudo realizar fast-forward. Revisar divergencias." "critical"
        fi
    done

    CURRENT_TARGET="forkhub"
    log "Ciclo finalizado. Actualizados: $updated_count | Al día: $up_to_date_count | Errores: $error_count"
}

cmd_add() {
    local add_name="${1:-}"
    local add_dir="${2:-}"
    local add_branch="${3:-}"
    local add_remote="${4:-origin}"
    local add_group="${5:-general}"

    if [[ -z "$add_name" || -z "$add_dir" ]]; then
        echo -e "${RED}Error: Se requieren al menos el nombre y la ruta del repositorio.${RESET}"
        echo "Uso: forkhub add <nombre> <ruta_dir> [branch] [remote] [group]"
        return 1
    fi

    local conf_file="$CONF_DIR/${add_name}.conf"
    if [[ -f "$conf_file" ]]; then
        echo -e "${RED}Error: Ya existe una configuración para '${add_name}' en $conf_file.${RESET}"
        return 1
    fi

    if [[ ! -d "$add_dir" ]]; then
        echo -e "${RED}Error: El directorio '$add_dir' no existe.${RESET}"
        return 1
    fi

    ensure_safe_directory "$add_dir"

    if ! git -C "$add_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo -e "${RED}Error: '$add_dir' no es un repositorio Git válido.${RESET}"
        return 1
    fi

    # Detectar rama actual si no se proveyó
    if [[ -z "$add_branch" ]]; then
        add_branch=$(git -C "$add_dir" branch --show-current 2>/dev/null || echo "main")
    fi

    mkdir -p "$CONF_DIR"
    cat << _CONF_ > "$conf_file"
# /etc/forkhub/repos.d/${add_name}.conf
# Configuración generada por forkhub add el $(date "+%Y-%m-%d %H:%M:%S")

name="${add_name}"
description="Repositorio ${add_name}"
repo_dir="${add_dir}"
remote="${add_remote}"
branch="${add_branch}"
group="${add_group}"
auto_update=true
post_update="chmod -R g+rwX ${add_dir} 2>/dev/null || true"
_CONF_

    chmod 664 "$conf_file" 2>/dev/null || true
    chown root:wheel "$conf_file" 2>/dev/null || true

    echo -e "${GREEN}¡Éxito! Repositorio '${add_name}' registrado en $conf_file.${RESET}"
    echo "  Grupo:  $add_group"
    echo "  Rama:   $add_branch"
    echo "  Remoto: $add_remote"
    echo "  Ruta:   $add_dir"
}

cmd_remove() {
    local rm_name="${1:-}"
    local force=false

    if [[ "$rm_name" == "-f" || "$rm_name" == "--force" ]]; then
        force=true
        rm_name="${2:-}"
    elif [[ "${2:-}" == "-f" || "${2:-}" == "--force" ]]; then
        force=true
    fi

    if [[ -z "$rm_name" ]]; then
        echo -e "${RED}Error: Especifique el nombre del repositorio a retirar.${RESET}"
        echo "Uso: forkhub remove <nombre> [-f|--force]"
        return 1
    fi

    local conf_file="$CONF_DIR/${rm_name}.conf"
    if [[ ! -f "$conf_file" ]]; then
        echo -e "${RED}Error: No existe el archivo de configuración $conf_file.${RESET}"
        return 1
    fi

    if [[ "$force" == "false" ]]; then
        read -rp "¿Está seguro de retirar '${rm_name}' de la flota forkhub? [s/N]: " confirm
        if [[ ! "$confirm" =~ ^[sS]$ ]]; then
            echo "Operación cancelada."
            return 0
        fi
    fi

    rm -f "$conf_file"
    echo -e "${GREEN}Configuración $conf_file eliminada.${RESET}"
    echo "Nota: El árbol local de archivos no ha sido modificado ni borrado."
}

# ==============================================================================
# ENRUTADOR PRINCIPAL
# ==============================================================================
case "${1:-}" in
    status)
        shift
        cmd_status "$@"
        ;;
    audit)
        shift
        cmd_audit "$@"
        ;;
    bare)
        shift
        cmd_bare "$@"
        ;;
    upstream|check-upstream)
        shift
        cmd_upstream "$@"
        ;;
    sync-upstream)
        shift
        cmd_sync_upstream "$@"
        ;;
    update)
        shift
        cmd_update "$@"
        ;;
    add)
        shift
        cmd_add "$@"
        ;;
    remove|rm)
        shift
        cmd_remove "$@"
        ;;
    list|repos|targets)
        shift
        cmd_list "$@"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        if [[ -z "${1:-}" ]]; then
            show_help
        else
            echo -e "${RED}Comando no reconocido: $1${RESET}"
            echo "Ejecute 'forkhub --help' para ver los comandos disponibles."
            exit 1
        fi
        ;;
esac
